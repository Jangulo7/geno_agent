# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env

# Project-specific large/derived data (NEVER commit)
data/pmc_oa/
data/intermediate/
data/phenopackets/*.tar.gz
data/phenopackets/*.zip
data/phenopackets/v*/
qdrant_storage/
models/
logs/
*.parquet
*.tsv.gz
*.jsonl
!data/MANIFEST.tsv
!.env.example

# Backup / temp files
*.bak
*.tmp
*.swp

# Manuscript conversion preview outputs (regenerable from
# scripts/manuscript/convert_apa_to_vancouver.py)
reports/_vancouver_preview/
reports/*.apa_backup_*

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace

# Downloaded ontology files (reproducible from URLs in MASTER_PROJECT_v2.1.md
# and SHA-256s in data/MANIFEST.tsv — never commit the bytes themselves)
data/Gene_Ontology/
data/HGNC/
data/Human_Phenotype_Ontology/
data/MONDO_Disease_Ontology/
data/ontologies/
data/hgnc

# Phase 2 frontend (CopilotKit / Next.js) — node_modules and build artifacts
# never go to git. The geno_agent-specific React components under
# frontend/src/geno_agent/ ARE committed; CopilotKit framework + node_modules
# are not.
frontend/node_modules/
frontend/.next/
frontend/.turbo/
frontend/.cache/
frontend/dist/
frontend/build/
frontend/*.tsbuildinfo
frontend/.env
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Paper-v3 RAGAS raw output (per-case prompts + contexts; 17.7 MB).
# Aggregate + per-case scores live in data/eval_1050/ragas_cell_S_n600_summary.json (101 KB, committed).
data/eval_1050/ragas_cell_S_n600.json
data/eval_1050/ragas_top1only_cell_S_n100.json

# LOPO per-case sidecars (38 MB / 3,143 files). Summaries
# data/eval_1050_lopo_full/_lopo_*.{md,json} ARE committed; per-case dirs are not
# (same convention as data/eval_1050/cell_*).
data/eval_1050_lopo_full/cell_S_control/
data/eval_1050_lopo_full/cell_S_lopo/
data/eval_1050_lopo_full/leak_S/

# Local agent state — Claude Code session state (do not commit)
.claude/
# DeepEval cache (created on import; per-machine, not reproducibility-critical)
.deepeval/

# Office documents — local drafts/exports, not tracked in the repo
*.odt
*.doc
*.docx

# Raw LLM response dumps (1.9 GB; regenerable from the per-case ranking JSONs).
# Per-case ranking JSONs in data/eval_1050/cell_{D,K,L,M,N,S}/ ARE committed.
data/eval_1050/cell_S_responses/
data/eval_1050/cell_L_responses/
# Pre-v2 aggregation snapshots (superseded by the committed cell_* + _results_*).
data/eval_1050/*_backup_*/

# Earlier-cohort eval artifacts (n=75 and n=500). Superseded by the n=1,047
# roster; reports archived under reports/_archive_n75/. Not tracked.
data/eval/cell_*/
data/eval_500/
data/test_cases/

# Windows alternate-data-stream sidecars (Zone.Identifier "mark of the web").
*Zone.Identifier

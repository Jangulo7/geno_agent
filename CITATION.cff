    given-names: Johanna
    affiliation: "Universidad Europea, Madrid"
license: AGPL-3.0-or-later
repository-code: "https://github.com/Jangulo7/geno_agent"
year: 2026
keywords:
  - rare disease
  - gene prioritization
  - retrieval-augmented generation
  - agentic workflow
  - Human Phenotype Ontology
  - clinical genomics
